[Unit]
Description=Gateway Process Manager
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=forking
User=root
ExecStartPre=/usr/local/tgg_gateway/bin/gw-pre-start.sh  # 启动前检查脚本
ExecStart=/usr/local/tgg_gateway/bin/gw-start.sh
ExecStop=/usr/local/tgg_gateway/bin/gw-graceful-stop.sh  # 优雅停止脚本
ExecStopPost=/usr/local/tgg_gateway/bin/gw-force-kill.sh  # 强制终止脚本
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s  # 正常停止超时时间
KillMode=process   # 仅终止主进程
Environment="PROC_ROOT=/usr/local/tgg_gateway/bin"

# 日志配置 (自动轮转)
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=gw-manager

[Install]
WantedBy=multi-user.target