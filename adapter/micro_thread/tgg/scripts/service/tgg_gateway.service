[Unit]
Description=Gateway Process Manager
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=forking
User=root
# 启动前检查脚本
ExecStartPre=/usr/local/tgg_gateway/bin/gw-pre-start.sh
ExecStart=/usr/local/tgg_gateway/bin/gw-start.sh
# 优雅停止脚本
ExecStop=/usr/local/tgg_gateway/bin/gw-graceful-stop.sh
# 强制终止脚本
ExecStopPost=/usr/local/tgg_gateway/bin/gw-force-kill.sh
Restart=on-failure
RestartSec=10s
# 最大等待停止超时时长
TimeoutStopSec=30s
# 仅终止主进程
KillMode=process
Environment="PROC_ROOT=/usr/local/tgg_gateway/bin"

# 日志配置 (自动轮转)
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=gw-manager

[Install]
WantedBy=multi-user.target